<Window x:Class="Alarmino.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarmino — Alarma"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Background="{DynamicResource BrushWindowBg}"
        Foreground="{DynamicResource BrushTextPrimary}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Nombre -->
        <TextBlock Grid.Row="0" Text="Nombre / alias" Style="{StaticResource SecondaryText}" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="P. ej. Entrada, Recreo, Salida…" Margin="0,0,0,10" />

        <!-- Hora -->
        <TextBlock Grid.Row="1" Text="Hora (HH:mm)" Style="{StaticResource SecondaryText}" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}"
                 Width="120" HorizontalAlignment="Left" Margin="0,0,0,10" />

        <!-- Días -->
        <TextBlock Grid.Row="2" Text="Días de la semana" Style="{StaticResource SecondaryText}" />
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,12">

            <CheckBox Content="L" IsChecked="{Binding DayMonday}" Margin="0,0,8,0" />
            <CheckBox Content="M" IsChecked="{Binding DayTuesday}" Margin="0,0,8,0" />
            <CheckBox Content="X" IsChecked="{Binding DayWednesday}" Margin="0,0,8,0" />
            <CheckBox Content="J" IsChecked="{Binding DayThursday}" Margin="0,0,8,0" />
            <CheckBox Content="V" IsChecked="{Binding DayFriday}" Margin="0,0,8,0" />
            <CheckBox Content="S" IsChecked="{Binding DaySaturday}" Margin="0,0,8,0" />
            <CheckBox Content="D" IsChecked="{Binding DaySunday}" />
        </StackPanel>

        <!-- Sonido -->
        <TextBlock Grid.Row="3" Text="Sonido" Style="{StaticResource SecondaryText}" />
        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,12">

            <RadioButton Content="Sonido predeterminado" IsChecked="{Binding UsePreset}" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding Presets}"
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedPresetId}"
                      Width="240" HorizontalAlignment="Left"
                      IsEnabled="{Binding UsePreset}" Margin="16,0,0,8" />

            <RadioButton Content="Archivo personalizado…" IsChecked="{Binding UseFile}" Margin="0,0,0,4" />
            <Grid Margin="16,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding FilePathDisplay}" Style="{StaticResource SecondaryText}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="Examinar…"
                        Command="{Binding BrowseCommand}"
                        Style="{StaticResource SecondaryButton}"
                        IsEnabled="{Binding UseFile}" Padding="12,4" />
            </Grid>
        </StackPanel>

        <!-- Modo -->
        <TextBlock Grid.Row="4" Text="Modo" Style="{StaticResource SecondaryText}" />
        <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,12">
            <RadioButton Content="Reproducir sonido completo" IsChecked="{Binding FullMode}" Margin="0,0,0,4" />
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Duración personalizada (segundos)" IsChecked="{Binding CustomMode}" />
                <TextBox Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}"
                         Width="70" Margin="8,0,0,0" IsEnabled="{Binding CustomMode}" />
            </StackPanel>
        </StackPanel>

        <!-- Repetición -->
        <TextBlock Grid.Row="5" Text="Repetir" Style="{StaticResource SecondaryText}" />
        <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,14">
            <CheckBox Content="Repetir el toque varias veces" IsChecked="{Binding RepeatEnabled}" Margin="0,0,0,4" />
            <StackPanel Orientation="Horizontal" IsEnabled="{Binding RepeatEnabled}" Margin="16,0,0,0">
                <TextBlock Text="Veces:" Style="{StaticResource SecondaryText}" />
                <TextBox Text="{Binding RepeatCountText, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="6,0" />
                <TextBlock Text="Pausa (s):" Style="{StaticResource SecondaryText}" />
                <TextBox Text="{Binding PauseText, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="6,0" />
            </StackPanel>
        </StackPanel>

        <!-- Error -->
        <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="{Binding ErrorMessage}" Foreground="{DynamicResource BrushDanger}"
                   TextWrapping="Wrap" Margin="0,0,0,10"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyTextToCollapsedConverter}}" />

        <!-- Acciones -->
        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding PreviewButtonText}"
                    Command="{Binding PreviewCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="14,8" />
            <Button Content="Cancelar"
                    Click="OnCancelClick"
                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="14,8" />
            <Button Content="Guardar" Click="OnSaveClick" Padding="20,8" />
        </StackPanel>
    </Grid>
</Window>