<Window x:Class="Alarmino.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarmino — Sirenas del colegio"
        Width="920" Height="660"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushWindowBg}"
        Foreground="{DynamicResource BrushTextPrimary}"
        Icon="pack://application:,,,/Resources/alarmino.ico">

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera: título a la izquierda, botón ALARMA a la derecha -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Alarmino" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="{Binding AppVersion}" Style="{StaticResource SecondaryText}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Margin="0,0,10,0"
                        Content="LLUVIA"
                        Command="{Binding TriggerRainCommand}"
                        VerticalAlignment="Center" Padding="20,10" MinHeight="40" FontSize="16"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsRainBlinkOn}" Value="True">
                                    <Setter Property="Background" Value="#111111" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="ALARMA"
                    Command="{Binding TriggerAlarmCommand}"
                    VerticalAlignment="Center" Padding="26,10" MinHeight="40" FontSize="16"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Background" Value="{DynamicResource BrushDanger}" />
                        <Setter Property="FontWeight" Value="Black" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BrushDangerHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsAlarmBlinkOn}" Value="True">
                                <Setter Property="Background" Value="#111111" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Barra de acciones -->
        <WrapPanel Grid.Row="1" Margin="0,8,0,12">
            <ToggleButton IsChecked="{Binding MasterEnabled}" MinWidth="150" Margin="0,0,12,0">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                        <Setter Property="Content" Value="BOTÓN GENERAL: APAGADO" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter Property="Content" Value="BOTÓN GENERAL: ENCENDIDO" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>

            <TextBlock Text="{Binding MasterStatusText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,24,0" />

            <TextBlock Text="Ordenar:" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <RadioButton Content="Por hora" IsChecked="{Binding SortByTime}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <RadioButton Content="Por día" IsChecked="{Binding SortByDay}" VerticalAlignment="Center" Margin="0,0,24,0" />

            <Button Content="＋ Añadir alarma" Command="{Binding AddAlarmCommand}" Padding="18,8" />
            <Button Content="⚙ Configuración" Click="OnSettingsClick"
                    Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Padding="14,8" />

            <ToggleButton IsChecked="{Binding IsLogExpanded, Mode=TwoWay}"
                          Margin="12,0,0,0" Padding="14,8"
                          ToolTip="Despliega el registro en vivo: estado de la red, pistas descargadas y operaciones de la sesión.">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                        <Setter Property="Content" Value="Ver log" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter Property="Content" Value="Ocultar log" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
        </WrapPanel>

        <!-- Parar la reproducción en curso -->
        <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,4,0,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding PlayerStatusText}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           ToolTip="Estado del reproductor: en espera, descargando o reproduciendo con el tiempo transcurrido." />
                <Button Content="PARAR ALARMA"
                        Command="{Binding StopSoundCommand}"
                        Visibility="{Binding IsSoundPlaying, Converter={StaticResource BoolToVisibilityConverter}}"
                        Style="{StaticResource DangerButton}" Padding="28,12" FontSize="15" />
            </StackPanel>
        </Grid>

        <!-- Panel de diagnóstico en vivo: red, pistas descargadas y registro de la sesión -->
        <Border Grid.Row="3"
                Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{DynamicResource BrushCardBg}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,4,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Indicadores: red y pistas descargadas -->
                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <Border CornerRadius="10" Padding="12,5" Margin="0,0,10,0"
                            Background="{DynamicResource BrushInputBg}">
                        <TextBlock Text="{Binding NetworkStatusText}" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNetworkOnline}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsNetworkOnline}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Border CornerRadius="10" Padding="12,5" Background="{DynamicResource BrushInputBg}">
                        <TextBlock Text="{Binding TrackStatusText}" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasReadyTrack}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasReadyTrack}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </WrapPanel>

                <!-- Detalle: caché de pistas y reproductor -->
                <TextBlock Grid.Row="1"
                           Text="{Binding DiagnosticsDetails}"
                           Style="{StaticResource SecondaryText}"
                           FontFamily="Consolas"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <!-- Registro en vivo -->
                <ScrollViewer Grid.Row="2"
                              x:Name="LogScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Background="{DynamicResource BrushInputBg}"
                              BorderBrush="{DynamicResource BrushBorder}"
                              BorderThickness="1"
                              Padding="6"
                              MinHeight="120"
                              MaxHeight="240">
                    <ItemsControl ItemsSource="{Binding LogLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Contenido: solo alarmas -->
        <Grid Grid.Row="4">
            <TextBlock Text="Todavía no hay alarmas. Pulsa «Añadir alarma» para crear la primera."
                       Style="{StaticResource SecondaryText}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasAlarms, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding AlarmsView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BrushCardBg}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Margin="0,0,0,12"
                                    Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Hora -->
                                    <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TimeText}" FontSize="34" FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushAccent}" />
                                        <TextBlock Text="{Binding RepeatText}" Style="{StaticResource SecondaryText}" />
                                    </StackPanel>

                                    <!-- Información -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DaysText}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />

                                        <ItemsControl ItemsSource="{Binding DayChips}" Margin="0,6,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4" Padding="7,2" Margin="0,0,4,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource BrushChipInactive}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Active}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource BrushChipActive}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Letter}" FontSize="11" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource BrushChipInactiveText}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Active}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource BrushChipActiveText}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="Sonido:" Style="{StaticResource SecondaryText}" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding SoundText}" Style="{StaticResource SecondaryText}" Margin="0,0,12,0" />
                                            <TextBlock Text="·" Style="{StaticResource SecondaryText}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding ModeText}" Style="{StaticResource SecondaryText}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Acciones -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                            <Button Content="Editar"
                                                    Command="{Binding DataContext.EditAlarmCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,6,0" />
                                            <Button Content="Eliminar"
                                                    Command="{Binding DataContext.DeleteAlarmCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButton}" Padding="12,6" />
                                        </StackPanel>

                                        <ToggleButton IsChecked="{Binding IsActive}" MinWidth="130"
                                                      HorizontalAlignment="Right">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                                    <Setter Property="Content" Value="Apagada" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Content" Value="Activa" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Pie -->
        <TextBlock Grid.Row="5" Margin="0,8,0,0" Style="{StaticResource SecondaryText}"
                   Text="Alarmino se guarda en segundo plano en la bandeja · Cierra la ventana para minimizar" />
    </Grid>
</Window>