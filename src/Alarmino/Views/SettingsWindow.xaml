<Window x:Class="Alarmino.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarmino — Configuración"
        Width="680"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Background="{DynamicResource BrushWindowBg}"
        Foreground="{DynamicResource BrushTextPrimary}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="0,0,0,8">
            <!-- Pestaña General -->
            <TabItem Header="General">
                <Grid Margin="8,14,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Volumen general" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                    <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding VolumePercent}" Style="{StaticResource SecondaryText}"
                                   Width="40" TextAlignment="Right" />
                        <Slider Minimum="0" Maximum="100" Value="{Binding VolumePercent, Mode=TwoWay}" />
                    </DockPanel>

                    <TextBlock Grid.Row="1" Text="Tema" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton Content="Oscuro" IsChecked="{Binding IsDarkMode}" Margin="0,0,16,0" />
                        <RadioButton Content="Claro" IsChecked="{Binding IsLightMode}" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Al iniciar Windows" Style="{StaticResource SecondaryText}" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                        <CheckBox IsChecked="{Binding AutoStartEnabled}" Margin="0,0,0,6">
                            <CheckBox.Content>
                                <TextBlock Text="Ejecutar Alarmino automáticamente al iniciar sesión" TextWrapping="Wrap" />
                            </CheckBox.Content>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding StartVisibleOnLogin}">
                            <CheckBox.Content>
                                <TextBlock Text="Mostrar la ventana al inicio (si no, arranca minimizado en la bandeja)" TextWrapping="Wrap" />
                            </CheckBox.Content>
                        </CheckBox>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="Notificaciones" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                        <CheckBox IsChecked="{Binding NotificationSoundEnabled}">
                            <CheckBox.Content>
                                <TextBlock Text="Mostrar notificaciones de Windows al saltar una alarma" TextWrapping="Wrap" />
                            </CheckBox.Content>
                        </CheckBox>
                    </StackPanel>

                    <Border Grid.Row="4" Grid.ColumnSpan="2" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Cómo funciona" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                       Text="Las alarmas solo suenan mientras Alarmino está en ejecución (permanece en la bandeja al cerrar la ventana). Para terminar la aplicación usa «Salir» desde el icono de la bandeja. El botón ALARMA reproduce varias veces seguidas el sonido que elijas, y el botón LLUVIA reproduce el de lluvia." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Pestaña ALARMA general -->
            <TabItem Header="ALARMA general">
                <Grid Margin="8,14,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Sonido de ALARMA" Style="{StaticResource SecondaryText}" VerticalAlignment="Top" Margin="0,6,0,0" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                        <RadioButton Content="Sonido predeterminado" IsChecked="{Binding AlarmButtonUsePreset}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AlarmButtonPresets}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding AlarmButtonPresetId}"
                                  Width="240" HorizontalAlignment="Left"
                                  IsEnabled="{Binding AlarmButtonUsePreset}" Margin="16,0,0,8" />

                        <RadioButton Content="Archivo personalizado…" IsChecked="{Binding AlarmButtonUseFile}" Margin="0,0,0,4" />
                        <Grid Margin="16,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding AlarmButtonFilePathDisplay}" Style="{StaticResource SecondaryText}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="Examinar…"
                                    Command="{Binding BrowseAlarmSoundCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    IsEnabled="{Binding AlarmButtonUseFile}" Padding="12,4" />
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Repeticiones" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,2,0,0" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,6">
                        <TextBlock Text="Veces: " Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        <TextBox Text="{Binding AlarmRepeatCount, UpdateSourceTrigger=PropertyChanged}" Width="46" VerticalAlignment="Center" />
                        <TextBlock Text="  Pausa entre toques (s): " Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        <TextBox Text="{Binding AlarmPauseSeconds, UpdateSourceTrigger=PropertyChanged}" Width="46" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Pestaña Botón de lluvia -->
            <TabItem Header="Botón de lluvia">
                <Grid Margin="8,14,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Sonido de LLUVIA" Style="{StaticResource SecondaryText}" VerticalAlignment="Top" Margin="0,6,0,0" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                        <RadioButton Content="Sonido predeterminado" IsChecked="{Binding RainButtonUsePreset}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding RainButtonPresets}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding RainButtonPresetId}"
                                  Width="240" HorizontalAlignment="Left"
                                  IsEnabled="{Binding RainButtonUsePreset}" Margin="16,0,0,8" />

                        <RadioButton Content="Archivo personalizado…" IsChecked="{Binding RainButtonUseFile}" Margin="0,0,0,4" />
                        <Grid Margin="16,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding RainButtonFilePathDisplay}" Style="{StaticResource SecondaryText}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="Examinar…"
                                    Command="{Binding BrowseRainSoundCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    IsEnabled="{Binding RainButtonUseFile}" Padding="12,4" />
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Repeticiones" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,2,0,0" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,6">
                        <TextBlock Text="Veces: " Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        <TextBox Text="{Binding RainRepeatCount, UpdateSourceTrigger=PropertyChanged}" Width="46" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Pestaña Sonidos predeterminados -->
            <TabItem Header="Sonidos predeterminados">
                <Grid Margin="8,14,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Editar presets" Style="{StaticResource SecondaryText}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Renombra cada sonido predeterminado y/o asígnale un archivo que lo sustituya. «Restablecer» vuelve al sonido sintetizado y al nombre original. Los cambios se ven en todos los desplegables." />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text=" " Style="{StaticResource SecondaryText}" />
                    <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding PresetEdits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding FilePathDisplay}" Style="{StaticResource SecondaryText}"
                                               VerticalAlignment="Center" Grid.Column="1" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="Cambiar…"
                                            Command="{Binding BrowseFileCommand}"
                                            Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,4,0" />
                                    <Button Grid.Column="3" Content="Restablecer"
                                            Command="{Binding ResetCommand}"
                                            Style="{StaticResource SecondaryButton}" Padding="10,4"
                                            IsEnabled="{Binding HasOverride}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Acciones -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,2,2">
            <Button Content="Cerrar" Click="OnCloseClick"
                    Style="{StaticResource SecondaryButton}" Padding="18,8" />
        </StackPanel>
    </Grid>
</Window>